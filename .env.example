# ============================================================
#  DPM2 Environment Configuration
# ============================================================

# --- Application & Network ---
APP_PORT=3000
NODE_ENV=production
# Optional LAN IP override (auto-detected if blank)
LAN_IP=
# Set COOKIE_SECURE=true only if using an HTTPS reverse proxy (e.g. Caddy, Nginx)
COOKIE_SECURE=false

# --- Better Auth ---
# Required: 32+ character random secret
BETTER_AUTH_SECRET=change-me-to-a-32-char-random-secret-key
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional comma-separated additional trusted origins
TRUSTED_ORIGINS=

# --- PostgreSQL Database (Docker & Local) ---
DB_USER=postgres
DB_PASSWORD=change-me-to-a-secure-password
DB_NAME=dpm
DB_HOST=db
DB_PORT=5432

# Local development connection string (used when running outside Docker)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dpm

# Docker Compose connection string (defaults to postgresql://${DB_USER}:${DB_PASSWORD}@db:5432/${DB_NAME})
# DOCKER_DATABASE_URL=postgresql://postgres:password@db:5432/dpm

# --- Default Seed Credentials (run 'pnpm db:seed' or 'docker compose exec app pnpm db:seed') ---
SEED_ADMIN_EMAIL=admin@dpm.local
SEED_ADMIN_PASSWORD=AdminPassword123!

# --- Feature Flags ---
ENABLE_DEV_IMPERSONATION=false
